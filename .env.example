# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so nothing
# here may ever hold a real key.
#
#   cp .env.example .env
#
# The tests read `.env` automatically. Anything else -- a script, an ingestion
# pipeline -- either exports these itself or loads the file:
#
#   set -a; source .env; set +a
#
# Nothing in the package reads a `.env` file on its own. `BlabladorEmbedder.from_env()`
# reads the *environment*, and every one of these values is also a plain keyword
# argument, so a caller with its own configuration layer can ignore all of this.


# --------------------------------------------------------------------------- #
# The embedding model -- juena_rag.embedding.blablador
# --------------------------------------------------------------------------- #

# The only value with no default, because there is no sensible one. The same key
# the chatbot already uses; ask whoever administers Blablador for one.
BLABLADOR_API_KEY=

# How many numbers are in one vector. Set here rather than left to the default,
# because this is the number the database column is created with -- and it is not a
# knob: changing it means a new table and re-embedding every chunk, so it is
# written down where it can be read rather than hidden in a Python constant.
#
# There is no separate variable for the table. `apply_ddl(dimension=...)` is given
# `embedder.metadata.dimension`, so the column can only ever be as wide as the
# model that fills it.
BLABLADOR_EMBEDDING_DIMENSION=4096

# The rest are here to be read, not to be set. Each falls back to the constant at
# the top of `blablador.py`, and the defaults are shown as the comment.

# BLABLADOR_BASE_URL=                     # https://api.helmholtz-blablador.fz-juelich.de/v1
# BLABLADOR_EMBEDDING_MODEL=              # alias-qwen3-8b-embeddings

# Pinned configuration rather than anything discovered from the server, so a model
# swapped underneath us is loud rather than quiet.
# BLABLADOR_EMBEDDING_MAX_INPUT_TOKENS=   # 8192


# --------------------------------------------------------------------------- #
# The database the tests run against -- juena_rag.store
# --------------------------------------------------------------------------- #

# `docker compose up -d` reads the three below; the tests read the fourth. They are
# written once and the connection string is built from them, because the two
# readers drifting apart is the worst failure this file can cause: a DSN whose
# password no longer matches looks exactly like a stopped container, and every
# database test *skips* rather than fails. Both docker compose and python-dotenv
# expand `${...}` here, so there is nothing to keep in step.

# The only one with no default. Weak is fine -- the container listens on loopback
# only and holds nothing but throwaway test data -- but it must be set, or compose
# would start a database with an empty password and not say so.
POSTGRES_PASSWORD=juena

# POSTGRES_USER=postgres                  # superuser, so the fixture may CREATE EXTENSION
# POSTGRES_DB=juena_rag
# POSTGRES_PORT=5433                      # on the host; 5432 inside the container

# Unset -- or set but unreachable, which is what a stopped container looks like --
# and every test needing a database skips instead of failing, so `uv run pytest`
# still works on a plane. Each test creates its own throwaway schema and drops it
# afterwards, but point this at a scratch database anyway.
JUENA_RAG_TEST_DSN=postgresql://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT:-5433}/${POSTGRES_DB:-juena_rag}
